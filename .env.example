# ── Required: Local MVP (callcallum) ──────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
MVP_DB_PROVIDER=sqlite
MVP_SQLITE_PATH=./data/callcallum.db

# ── AI Provider (default: OpenCode Go; switch to OpenRouter if needed) ─
AI_PROVIDER=opencode-go
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_API_KEY=
AI_CALLER_MODEL=deepseek-v4-flash
AI_EVALUATOR_MODEL=deepseek-v4-flash
AI_TICKET_MODEL=deepseek-v4-flash
AI_REPORT_MODEL=deepseek-v4-flash
# AI_FALLBACK_MODEL=deepseek-v4-flash
#
# To switch to OpenRouter, uncomment:
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_CALLER_MODEL=openai/gpt-4o-mini
# AI_EVALUATOR_MODEL=openai/gpt-4o-mini
# AI_TICKET_MODEL=openai/gpt-4o-mini
# AI_REPORT_MODEL=openai/gpt-4o-mini
# AI_FALLBACK_MODEL=openai/gpt-4o-mini:free

# ── Voice / STT (OpenRouter) + TTS (Azure Neural, default) ───────
# STT via OpenRouter:
# OPENROUTER_API_KEY=
VOICE_STT_MODEL=openai/whisper-large-v3-turbo
# TTS via Azure Neural (default — set AZURE_TTS_KEY to enable):
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
AZURE_TTS_VOICE=en-GB-SoniaNeural
# TTS fallback via OpenRouter (used if AZURE_TTS_KEY not set):
# VOICE_TTS_MODEL=hexgrad/kokoro-82m
# VOICE_TTS_VOICE=af_heart

# ── Legacy / Frozen (not required for MVP) ───────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# CHUTES_API_KEY=
# CHUTES_API_URL=https://llm.chutes.ai/v1
# CHUTES_MODEL=moonshotai/Kimi-K2.5-TEE
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
# ENABLE_DEMO=false
